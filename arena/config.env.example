# Base
BASE_REPO=$HOME/IdeaProjects/anchor-multiple
BASE_BRANCH=develop

# Worktree roots (required convention)
CODEX_WORKTREE_ROOT=${CODEX_HOME:-$HOME/.codex}/worktrees
CLAUDE_WORKTREE_ROOT=${BASE_REPO}/.claude/worktrees

# Agent commands
CODEX_CMD=codex
CLAUDE_CMD=claude

# UI
ARENA_UI_MODE=auto
AUTO_OPEN_REVIEW_UI=1
AUTO_OPEN_ASSIMILATION_UI=1
INTERACTIVE_WINNER_PICK=1

# Prompt mode
# NOTE: codex does not interpret a file path argument as a prompt file.
# stdin/file both resolve to: command "$(cat <prompt-file>)"
CODEX_PROMPT_MODE=stdin
CLAUDE_PROMPT_MODE=stdin

# Snapshot / collect
AUTO_COMMIT=1
AUTO_UPDATE_GITIGNORE=0
ARENA_COLLECT_PARALLEL=1
TEST_CMD_CODEX=
TEST_CMD_CLAUDE=
RETENTION_DAYS=7

# Optional (new-style per-agent overrides)
# ARENA_AGENT_CODEX_CMD=codex
# ARENA_AGENT_CLAUDE_CMD=claude
# ARENA_AGENT_GEMINI_CMD=gemini

# Optional agent config directory (additional *.conf loader)
# ARENA_AGENT_CONF_EXTRA_DIR=/Users/you/customScripts/arena/agents.d
