# bin/orchestrator
#!/bin/bash
set -e
# Get the directory where the script is located, and resolve it to an absolute path.
SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
# All operations will be relative to the user's current directory,
# but the python script itself needs to be found.
python3 "$PROJECT_ROOT/main.py" "$@"
